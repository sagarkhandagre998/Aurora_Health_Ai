EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_anon_key_here

# Google Sign-In (Continue with Google)
# Create OAuth clients in Google Cloud Console → APIs & Services → Credentials.
# Web client ID: type "Web application" — used by Android + as the Supabase token audience.
# iOS client ID: type "iOS" (bundle id com.healthtracker) — required on iOS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
